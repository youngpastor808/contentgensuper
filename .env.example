# Application Environment & Server Port
NODE_ENV=production
PORT=3000

# Gemini / Vertex AI Configuration
GEMINI_API_KEY=
VERTEXAI=true
VERTEX_PROJECT_ID=contentgenapp-507516
VERTEX_LOCATION=us-central1

# Google Cloud Project & Storage
GCP_PROJECT_ID=contentgenapp-507516
GCS_BUCKET=

# Google Cloud Service Account Credentials (Optional if running on Cloud Run with attached Service Account)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Firebase / Firestore Project Overrides (Optional)
FIREBASE_PROJECT_ID=contentgenapp-507516
FIRESTORE_DATABASE_ID=contentgen-ai

# Third-Party Audio APIs
DEEPGRAM_API_KEY=

# Google Workspace / OAuth Client ID
VITE_GOOGLE_CLIENT_ID=

# Desktop Mode Security (Optional)
DESKTOP_STUDIO_PASSWORD=

# Remotion Rendering via Google Cloud Run (Recommended on GCP)
REMOTION_GCP_PROJECT_ID=contentgenapp-507516
REMOTION_GCP_REGION=us-central1
REMOTION_GCP_SERVICE_NAME=
REMOTION_GCP_SERVE_URL=
REMOTION_GCP_BUCKET=contentgenapp-remotion-us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# AWS S3 Storage for Media & Uploaded Assets (Optional - if separate from Remotion Lambda bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_MEDIA_BUCKET=

# Remotion Cloud Rendering via AWS Lambda (Alternative)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=us-east-1
REMOTION_SERVE_URL=
REMOTION_FUNCTION_NAME=remotion-render-4-0-527-arm64-mem2048mb-disk10240mb-900sec
REMOTION_MAX_CONCURRENT_RENDERS=3
REMOTION_AWS_CONCURRENCY_BUDGET=540
REMOTION_AWS_MAX_LAMBDA_CONCURRENCY=180
REMOTION_AWS_MIN_LAMBDA_CONCURRENCY=16
REMOTION_TARGET_CHUNK_SECONDS=20
REMOTION_AWS_MAX_DURATION_MINUTES=75
REMOTION_AWS_OUTPUT_PRIVACY=private
REMOTION_AWS_OUTPUT_URL_TTL_SECONDS=900

# Base URL of your deployed web/Cloud Run server. Only used by the desktop
# (Electron) build, only for /api/cloud-render/* calls, so headless
# Chromium always runs on your server, never on the user's machine.
VITE_REMOTE_CLOUD_RENDER_BASE_URL=https://your-app.run.app

